# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/

# Environment variables
.env
!.env.example

# Logs
logs/*
!logs/.gitkeep
*.log

